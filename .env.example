# Quote form email (Resend) — used by api/send-quote.js
# Copy this file to .env for local development. In production, set the same
# variables in your host's dashboard (e.g. Vercel → Settings → Environment Variables).
# Never commit the real .env file.
RESEND_API_KEY=
QUOTE_TO_EMAIL=scrimmy@rslini.resend.app
# Resend's test sender only delivers to your own Resend account email.
# After verifying your domain in Resend, use e.g. "Perkins Website <quotes@perkinslawnandsnow.com>"
QUOTE_FROM_EMAIL=Perkins Website <onboarding@resend.dev>
